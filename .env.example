# 로컬 design-assets 클론 후 프리뷰에 사내 ODS 정적 파일 사용
# npm run setup:local-ods
NEXT_PUBLIC_USE_LOCAL_ODS=true

# 빌더 가운데 패널을 /preview/[slug]?embed=1 iframe 으로 (Storybook 과 동일 렌더 트리)
# false 로 두면 인라인 PreviewRenderer (에셋 슬롯 클릭 편집 가능)
NEXT_PUBLIC_PREVIEW_IFRAME=true

# design-assets 클론 경로 (선택 — npm run clone:ods 가 vendor 로 symlink)
# DESIGN_ASSETS_ROOT=/Users/you/Documents/GitHub/design-assets
# DESIGN_ASSETS_REPO=git@github.com:bucketplace/design-assets.git

# ── 프롬프트 자동 구성 (ComposePrompt) ─────────────────────────
# 노션 페이지 URL 을 붙여넣으면 /api/notion-fetch 가 본문을 평문화해서 매처로 전달.
# Notion Internal Integration Token — https://www.notion.so/my-integrations
# (사내 통합이라면 통합을 추가한 페이지/데이터베이스만 접근 가능)
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stock photo 자동 fill — 미설정 시 Picsum 폴백 (검색어 무시 랜덤)
# NEXT_PUBLIC_PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 매칭 활성화 — /api/compose 라우트 (별도 구현 필요)
# NEXT_PUBLIC_PROMPT_COMPOSE_LLM=on
